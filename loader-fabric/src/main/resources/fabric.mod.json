  "mixins": [
    "krasnokamen-loader.mixins.json",
    "krasnokamen-loader-input.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "fabric-api": "*",
    "minecraft": "=26.1.2",
    "java": ">=25"
  }
}
