{
  "schemaVersion": 1,
  "id": "krasnokamen_loader",
  "version": "0.1.0",
  "name": "Krasnokamen Loader",
  "description": "Krasnokamen client-bundle configuration transport.",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.krasnokamen.loader.fabric.KrasnokamenFabricContent"
    ],
    "client": [
      "dev.krasnokamen.loader.fabric.KrasnokamenFabricLoader"
    ]
