# Gradle caches and compiled output (includes Loom/Mojang-derived caches).
.gradle/
**/build/

# Per-run Minecraft game directories created by runClient* tasks.
**/run*/

# Logs written by loader/moddev runs.
/logs/
**/logs/

# Local-only caches: MCP game dirs, client jars, loom artifacts, scratch logs.
# Never commit Mojang/mapped/generated bytes; reprovision locally instead.
.analysis/

# IDE and OS noise.
.idea/
.vscode/
*.iml
.DS_Store
